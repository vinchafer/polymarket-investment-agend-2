DATABASE_PATH=./agent.db
DRY_RUN=true
EXECUTION_MODE=paper
STARTING_CAPITAL_USDC=50
TRACK_PAPER_CASH=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
# Comma-separated origins for Vercel (or * for dev only)
DASHBOARD_CORS_ORIGINS=*
# Optional shared secret; iPhone/Vercel frontend sends Authorization: Bearer …
DASHBOARD_READ_TOKEN=
LEADERBOARD_TIME_PERIOD=MONTH
LEADERBOARD_CATEGORY=OVERALL
LEADERBOARD_ORDER_BY=PNL
WALLET_CURATOR_INTERVAL_HOURS=6
LLM_MAX_RETRIES=3
# Optional: absolute path to a secrets file (never commit)
# EXTRA_ENV_FILE=C:\Users\you\.cursor\projects\c-Users-vinch-polymarket-investment-agend-2\env.txt

# AI
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=25
API_TIMEOUT_SECONDS=20
SCOUT_MAX_WALLETS=8

# Trading
POLYMARKET_PRIVATE_KEY=
POLYMARKET_PROXY_ADDRESS=
POLYMARKET_CHAIN_ID=137

# Data APIs
POLYMARKET_DATA_API=https://data-api.polymarket.com
POLYMARKET_GAMMA_API=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API=https://clob.polymarket.com
THE_ODDS_API_KEY=
NEWS_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
ESPN_API_BASE=https://site.api.espn.com/apis/site/v2

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
